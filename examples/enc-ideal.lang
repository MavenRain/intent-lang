-- The ideal model of Enc in kit mode (S5, rule O7). The kit is the trusted
-- test scope, so it may evaluate decrypt, observe and the projection encOf.
-- An Enc value is an encEta term: decrypt is its fold, observe is decrypt
-- under trunc1.
def sizeAdd : Size -> Size -> Size :=
  fun (n : Size) (m : Size) => fold m (fun (r : Size) => szS r) n
def encOne : Enc Size := encEta Size (szS sz0)
def encSum : Enc Size := encOp2 Size Size Size sizeAdd encOne encOne
def openSum : Size := decrypt Size encSum
def openOne : Size := encOf encOne
def seenSum : Trunc1 Size := observe Size encSum
