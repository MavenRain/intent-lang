-- The word-level intent helpers of examples/intentsig.lang (copied; its fillAuth is sigFill here).
def intentTag : U256 := 0x696e74656e74u

def cipherDigest : (a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y d0 d1 d2 d3 : U256) -> U256 :=
  fun (a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y d0 d1 d2 d3 : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash a1x a1y) a2x) a2y) s1x) s1y) s2x) s2y) m1x) m1y) m2x) m2y) d0) d1) d2) d3

def intentHash : (inTok outTok ct : U256) -> (owner : Addr) -> (nonce start : U256) -> U256 :=
  fun (inTok outTok ct : U256) (owner : Addr) (nonce start : U256) =>
    hash (hash (hash (hash (hash (hash intentTag inTok) outTok) ct) (addrToU256 owner)) nonce) start

def replayKey : (owner : Addr) -> (nonce : U256) -> U256 :=
  fun (owner : Addr) (nonce : U256) => hash (addrToU256 owner) nonce

-- An invalid signature gives the address 0 (R18), so the owner 0 must not match.
def sigFill : (h : U256) -> (v : Nat) -> (r w : U256) -> (owner : Addr) -> Flag :=
  fun (h : U256) (v : Nat) (r w : U256) (owner : Addr) =>
    flagIf (addrEq owner 0x0000000000000000000000000000000000000000) flagNo (addrEq (ecrecover h v r w) owner)



-- The fill (survey section 7). The record of an intent h: fills at h is 1u after fillAuth, at hash h 0u
-- the cipher digest D, 4u the start, 5u the replay key, 6u + k the opened amount k (amtIn, startOut,
-- minOut) and 9u + k its flag; addrs at hash h 1u inTok, 2u outTok, 3u the owner. fills at D is 1u after
-- fillCipher, and hash D i (i = 4 k + 0 .. 3, c1x c1y c2x c2y of amount k) holds the 12 amount words.
event Settled (settledHash : U256)
event Cancelled (cancelKey : U256)

def fillWord : (s : State) -> (h i : U256) -> U256 :=
  fun (s : State) (h i : U256) => mapGet (fills s) (hash h i)
def minOf : (a b : U256) -> U256 :=
  fun (a b : U256) => flagIf (u256Le a b) a b

-- The bounded multiply of Q-S10-11 (a) and Q-S11-5 (c): times k x = k x for k = 0u .. 16u (a sum
-- chain, no multiply prim). times8 is the chain for k = 0u .. 8u (k more than 8u gives 8 x); times k x
-- for k more than 8u is 8 x + times8 (k - 8u) x, so k more than 16u gives 16 x. fillSettle reverts when
-- the window is more than 16u, and t <= window.
def twice : (x : U256) -> U256 :=
  fun (x : U256) => u256Add x x
def times8 : (k x : U256) -> U256 :=
  fun (k x : U256) =>
    flagIf (u256Le k 3u)
      (flagIf (u256Le k 1u) (flagIf (u256Eq k 0u) 0u x) (flagIf (u256Eq k 2u) (twice x) (u256Add (twice x) x)))
      (flagIf (u256Le k 5u)
        (flagIf (u256Eq k 4u) (twice (twice x)) (u256Add (twice (twice x)) x))
        (flagIf (u256Le k 7u)
          (flagIf (u256Eq k 6u) (twice (u256Add (twice x) x)) (u256Add (twice (u256Add (twice x) x)) x))
          (twice (twice (twice x)))))

def times : (k x : U256) -> U256 :=
  fun (k x : U256) =>
    flagIf (u256Le k 8u) (times8 k x) (u256Add (twice (twice (twice x))) (times8 (u256Sub k 8u) x))

-- Rule 4.1 at word level: w (so - o) <= t (so - mo), as w so + t mo <= w o + t so (no u256Sub
-- trap); o at least both endpoints is accepted at once.
def aboveEnds : (so mo o : U256) -> Flag :=
  fun (so mo o : U256) => flagIf (u256Le so o) (u256Le mo o) flagNo
def acceptW : (w t so mo o : U256) -> Flag :=
  fun (w t so mo o : U256) =>
    flagIf (aboveEnds so mo o) flagYes (u256Le (u256Add (times w so) (times t mo)) (u256Add (times w o) (times t so)))

-- The opening of the kept amount (c1, c2) with the shares of the quorum {1, 2} (openSum of enact).
def openKept : (c1 c2 : Prod U256 U256) -> (d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) -> Flag :=
  fun (c1 c2 : Prod U256 U256) (d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) =>
    openSum c1 c2 (first c1) (second c1) (first c2) (second c2) d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m

def keepCipher : (s : State) -> (d a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y : U256) -> State :=
  fun (s : State) (d a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y : U256) =>
    makeState (window s) (keys s)
      (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (mapSet (fills s)
        d 1u) (hash d 0u) a1x) (hash d 1u) a1y) (hash d 2u) a2x) (hash d 3u) a2y) (hash d 4u) s1x) (hash d 5u) s1y)
        (hash d 6u) s2x) (hash d 7u) s2y) (hash d 8u) m1x) (hash d 9u) m1y) (hash d 10u) m2x) (hash d 11u) m2y)
      (addrs s)
def keepIntent : (s : State) -> (h d : U256) -> (inTok outTok owner : Addr) -> (start key : U256) -> State :=
  fun (s : State) (h d : U256) (inTok outTok owner : Addr) (start key : U256) =>
    makeState (window s) (keys s)
      (mapSet (mapSet (mapSet (mapSet (fills s) h 1u) (hash h 0u) d) (hash h 4u) start) (hash h 5u) key)
      (mapSet (mapSet (mapSet (addrs s) (hash h 1u) inTok) (hash h 2u) outTok) (hash h 3u) owner)
def keepOpen : (s : State) -> (h k m : U256) -> State :=
  fun (s : State) (h k m : U256) =>
    makeState (window s) (keys s)
      (mapSet (mapSet (fills s) (hash h (u256Add k 6u)) m) (hash h (u256Add k 9u)) 1u) (addrs s)
def keyMark : (s : State) -> (key : U256) -> State :=
  fun (s : State) (key : U256) =>
    makeState (window s) (mapSet (keys s) key flagYes) (fills s) (addrs s)
def opened : (s : State) -> (h : U256) -> Flag :=
  fun (s : State) (h : U256) =>
    flagIf (u256Eq (fillWord s h 9u) 1u) (flagIf (u256Eq (fillWord s h 10u) 1u) (u256Eq (fillWord s h 11u) 1u) flagNo) flagNo

-- Entry fillCipher (16 words): the 12 amount words under D = cipherDigest.
def fillCipher : (env : Env) -> (s : State) -> (a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y d0 d1 d2 d3 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y d0 d1 d2 d3 : U256) =>
    some (pair (keepCipher s (cipherDigest a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y d0 d1 d2 d3)
      a1x a1y a2x a2y s1x s1y s2x s2y m1x m1y m2x m2y) nil)

-- Entry fillAuth (9 words): D has a fillCipher, the replay key of (owner, nonce) is not in keys, the
-- owner signed h = intentHash, then the record of h.
def fillAuth : (env : Env) -> (s : State) -> (inTok outTok : Addr) -> (d : U256) -> (owner : Addr) -> (nonce start : U256) -> (v : Nat) -> (r w : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (inTok outTok : Addr) (d : U256) (owner : Addr) (nonce start : U256) (v : Nat) (r w : U256) =>
    flagIf (u256Eq (mapGet (fills s) d) 1u)
      (flagIf (mapGet (keys s) (replayKey owner nonce))
        none
        (flagIf (sigFill (intentHash (addrToU256 inTok) (addrToU256 outTok) d owner nonce start) v r w owner)
          (some (pair (keepIntent s (intentHash (addrToU256 inTok) (addrToU256 outTok) d owner nonce start) d
            inTok outTok owner start (replayKey owner nonce)) nil))
          none))
      none

-- Entry fillOpen (17 words): h has a record, k is 0, 1 or 2, m is below the BN254 subgroup order
-- (l2 is that order minus 1), the opening of amount k with m, then m and the flag of k.
def fillOpen : (env : Env) -> (s : State) -> (h k d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (h k d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m : U256) =>
    flagIf (u256Eq (mapGet (fills s) h) 1u)
      (flagIf (u256Le k 2u)
        (flagIf (u256Le m l2)
          (flagIf (openKept (kept (fills s) (fillWord s h 0u) (slotBase k)) (kept (fills s) (fillWord s h 0u) (u256Add (slotBase k) 2u))
                d1x d1y a1x a1y b1x b1y z1 d2x d2y a2x a2y b2x b2y z2 m)
            (some (pair (keepOpen s h k m) nil))
            none)
          none)
        none)
      none

-- Entry fillSettle (6 words: h o so mo st amt, Q-S11-8 (a)): the 3 openings, the replay key not in keys, then
-- so = startOut, mo = minOut, st = start and amt = amtIn of h (each stored word checked one time against fillWord;
-- a wrong word reverts, so the inline copies of times are call-data loads), block >= start, window <= 16u
-- (Q-S10-11, Q-S11-5 (c)), t = min (block - start) window, Accept window t startOut minOut o (rule 4.1), then the key
-- to keys, pull inTok owner caller amtIn, pull outTok caller owner o, Settled h.
def fillSettle : (env : Env) -> (s : State) -> (h o so mo st amt : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (h o so mo st amt : U256) =>
    flagIf (opened s h)
      (flagIf (mapGet (keys s) (fillWord s h 5u))
        none
        (flagIf (u256Eq so (fillWord s h 7u))
          (flagIf (u256Eq mo (fillWord s h 8u))
            (flagIf (u256Eq st (fillWord s h 4u))
              (flagIf (u256Eq amt (fillWord s h 6u))
                (flagIf (u256Le st (block env))
                  (flagIf (u256Le (window s) 16u)
                    (flagIf (acceptW (window s) (minOf (u256Sub (block env) st) (window s)) so mo o)
                      (some (pair (keyMark s (fillWord s h 5u))
                        (cons (pull (mapGet (addrs s) (hash h 1u)) (mapGet (addrs s) (hash h 3u)) (caller env) amt)
                          (cons (pull (mapGet (addrs s) (hash h 2u)) (caller env) (mapGet (addrs s) (hash h 3u)) o)
                            (cons (Settled h) nil)))))
                      none)
                    none)
                  none)
                none)
              none)
            none)
          none))
      none

-- Entry transfer (2 words, Q-S11-2 (a)): enact of the DAO pushes the window as a pay to this
-- contract (the ERC-20 transfer selector). Revert unless the caller is the DAO; the to word is not read.
def transfer : (env : Env) -> (s : State) -> (to : Addr) -> (amount : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (to : Addr) (amount : U256) =>
    flagIf (u256Eq (addrToU256 (caller env)) (addrToU256 dao))
      (some (pair (makeState amount (keys s) (fills s) (addrs s)) nil))
      none

-- Entry cancel (1 word): the replay key of (caller, nonce) to keys.
def cancel : (env : Env) -> (s : State) -> (nonce : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (nonce : U256) =>
    some (pair (keyMark s (replayKey (caller env) nonce)) (cons (Cancelled (replayKey (caller env) nonce)) nil))

-- Views: the window, the opened amount k of h, and 1u when the replay key of (owner, nonce) is in keys.
def windowOf : (env : Env) -> (s : State) -> U256 :=
  fun (env : Env) (s : State) => window s
def amountOf : (env : Env) -> (s : State) -> (h k : U256) -> U256 :=
  fun (env : Env) (s : State) (h k : U256) => fillWord s h (u256Add k 6u)
def closedOf : (env : Env) -> (s : State) -> (owner : Addr) -> (nonce : U256) -> U256 :=
  fun (env : Env) (s : State) (owner : Addr) (nonce : U256) => flagIf (mapGet (keys s) (replayKey owner nonce)) 1u 0u

-- Eval rows of the fill: the cipher, nonce 7, the 3 openings (m 3, 8, 4) at BLOCK 0, then fillSettle at
-- BLOCK 102 (t 2): o 6 is short at window 6, settles after enact (a transfer by the DAO sets window 4); o 3 at BLOCK 108 (t 8 > 4)
-- reverts; the replay reverts; a cancel by the owner closes nonce 8.
def e0 : Env := makeEnv 0 0u 0x00000000000000000000000000000000000000aa
def eDao : Env := makeEnv 0 0u dao
def e102 : Env := makeEnv 102 102u 0x00000000000000000000000000000000000000aa
def e108 : Env := makeEnv 108 108u 0x00000000000000000000000000000000000000aa
def eOwner : Env := makeEnv 0 0u owner
def fillOn : (s : State) -> Option (Prod State (List Out)) :=
  fun (s : State) =>
    bind (fillCipher e0 s fac1x fac1y fac2x fac2y fsc1x fsc1y fsc2x fsc2y fmc1x fmc1y fmc2x fmc2y d0 d1 d2 d3) (fun (a : Prod State (List Out)) =>
      bind (fillAuth e0 (first a) inTok outTok digest owner 7u start n7v n7r n7w) (fun (b : Prod State (List Out)) =>
        bind (fillOpen e0 (first b) n7hash 0u oad1x oad1y oaa1x oaa1y oab1x oab1y oaz1 oad2x oad2y oaa2x oaa2y oab2x oab2y oaz2 3u) (fun (c : Prod State (List Out)) =>
          bind (fillOpen e0 (first c) n7hash 1u osd1x osd1y osa1x osa1y osb1x osb1y osz1 osd2x osd2y osa2x osa2y osb2x osb2y osz2 8u) (fun (d : Prod State (List Out)) =>
            fillOpen e0 (first d) n7hash 2u omd1x omd1y oma1x oma1y omb1x omb1y omz1 omd2x omd2y oma2x oma2y omb2x omb2y omz2 4u))))
def f6 : Option (Prod State (List Out)) := fillOn init
def fEnacted : Option (Prod State (List Out)) := bind (transfer eDao init dao 4u) (fun (q : Prod State (List Out)) => fillOn (first q))
def fillMin : Option U256 := map (fun (r : Prod State (List Out)) => amountOf e0 (first r) n7hash 2u) f6
def fillShort : Option (Prod State (List Out)) := bind f6 (fun (r : Prod State (List Out)) => fillSettle e102 (first r) n7hash 6u 8u 4u start 3u)
def fillLow : Option (Prod State (List Out)) := bind fEnacted (fun (r : Prod State (List Out)) => fillSettle e108 (first r) n7hash 3u 8u 4u start 3u)
def fillDone : Option U256 := map (fun (q : Prod State (List Out)) => closedOf e0 (first q) owner 7u) (bind fEnacted (fun (r : Prod State (List Out)) => fillSettle e102 (first r) n7hash 6u 8u 4u start 3u))
def fillReplay : Option (Prod State (List Out)) := bind (bind fEnacted (fun (r : Prod State (List Out)) => fillSettle e102 (first r) n7hash 6u 8u 4u start 3u)) (fun (q : Prod State (List Out)) => fillSettle e102 (first q) n7hash 6u 8u 4u start 3u)
def cancelOwner : Option (Prod State (List Out)) := bind (bind f6 (fun (r : Prod State (List Out)) => cancel eOwner (first r) 8u)) (fun (q : Prod State (List Out)) => fillAuth e0 (first q) inTok outTok digest owner 8u start n8v n8r n8w)
def cancelOther : Option U256 := map (fun (q : Prod State (List Out)) => closedOf e0 (first q) owner 8u) (bind (bind f6 (fun (r : Prod State (List Out)) => cancel e0 (first r) 8u)) (fun (q : Prod State (List Out)) => fillAuth e0 (first q) inTok outTok digest owner 8u start n8v n8r n8w))

-- Eval rows of the window and of times: the DAO caller sets 4u, another caller reverts; times 9u, 16u
-- and 17u of 7u (17u gives 16 x); at window 17u fillSettle reverts (o 8u = startOut, accepted at once
-- without the cap).
def windowPush : Option U256 := map (fun (r : Prod State (List Out)) => windowOf e0 (first r)) (transfer eDao init dao 4u)
def windowOther : Option (Prod State (List Out)) := transfer e0 init dao 4u
def times9 : U256 := times 9u 7u
def times16 : U256 := times 16u 7u
def times17 : U256 := times 17u 7u
def fillCap : Option (Prod State (List Out)) :=
  bind (bind (transfer eDao init dao 17u) (fun (q : Prod State (List Out)) => fillOn (first q))) (fun (r : Prod State (List Out)) => fillSettle e102 (first r) n7hash 8u 8u 4u start 3u)

-- Eval row of the call words (Q-S11-8 (a)): the settle of fillDone with so 9u in place of startOut 8u and o 7u
-- reverts (Accept takes o 7u at t 2 with so 8u and with so 9u, so only the so check reverts).
def fillWord8 : Option (Prod State (List Out)) := bind fEnacted (fun (r : Prod State (List Out)) => fillSettle e102 (first r) n7hash 7u 9u 4u start 3u)

-- The price rule also covers increasing endpoints without accepting the start price after t = 0.
def risingLow : Flag := acceptW 4u 2u 4u 8u 4u
def risingExact : Flag := acceptW 4u 2u 4u 8u 6u
def risingStart : Flag := acceptW 4u 0u 4u 8u 4u
def risingEnd : Flag := acceptW 4u 4u 4u 8u 4u
